{
  "schema_version": 1,
  "mode": "manual",
  "manual_session": "new_on_open",
  "entry": "policy/bangbang_coast_v4/entry.py",
  "parameters": {},
  "model": "nominal_model.json",
  "dependencies": [
    "policy/bangbang_coast_v4/__init__.py",
    "policy/bangbang_coast_v4/entry.py",
    "policy/bangbang_coast_v4/core.py",
    "policy/bangbang_coast_v4/legacy_flight.py",
    "policy/bangbang_coast_v4/settings.json",
    "policy/bangbang_coast_v4/run_plan.json",
    "system_identification/model.py",
    "policy/bangbang_coast_v4/adaptive.py",
    "policy/bangbang_coast_v4/coast_monitor.py",
    "policy/bangbang_coast_v4/recovery.py",
    "policy/bangbang_coast_v4/joint.py",
    "policy/bangbang_coast_v4/flight.py",
    "policy/bangbang_coast_v4/startup.py"
  ],
  "output_root": "policy/bangbang_coast_v4/run_logs",
  "schedule": {
    "cases": [
      {
        "id": "BANGBANG_COAST_V4",
        "parameters": {}
      }
    ],
    "repetitions_per_case": 1,
    "repeat_set": {
      "mode": "fixed",
      "count": 1
    },
    "order": "listed"
  },
  "retry": {
    "max_retries_per_trial": 0,
    "retry_on": [
      "startup_timeout",
      "backend_disconnect",
      "simulation_clock_stall"
    ],
    "on_exhausted": "pause"
  },
  "on_task_failure": "continue",
  "limits": {
    "startup_wall_s": 150,
    "heartbeat_wall_s": 45,
    "clock_stall_wall_s": 90,
    "attempt_wall_s": null,
    "shutdown_wall_s": 30,
    "task_sim_s": null
  },
  "logging": {
    "state_period_s": 0.2
  }
}
