{
  "schema_version": 1,
  "mode": "manual",
  "manual_session": "new_on_open",
  "entry": "obstacle_characterization/smoke.py",
  "parameters": {
    "duration_s": 4.0
  },
  "model": null,
  "dependencies": [
    "obstacle_characterization/__init__.py",
    "obstacle_characterization/radar.py",
    "obstacle_characterization/collision.py",
    "obstacle_characterization/runtime.py",
    "obstacle_characterization/settings.json"
  ],
  "output_root": "obstacle_characterization/smoke_logs",
  "schedule": {
    "cases": [
      {
        "id": "default",
        "parameters": {}
      }
    ],
    "repetitions_per_case": 1,
    "repeat_set": {
      "mode": "fixed",
      "count": 1
    },
    "order": "listed"
  },
  "retry": {
    "max_retries_per_trial": 0,
    "retry_on": [
      "startup_timeout",
      "backend_disconnect",
      "simulation_clock_stall"
    ],
    "on_exhausted": "pause"
  },
  "on_task_failure": "continue",
  "limits": {
    "startup_wall_s": 150,
    "heartbeat_wall_s": 45,
    "clock_stall_wall_s": 90,
    "attempt_wall_s": 90.0,
    "shutdown_wall_s": 30,
    "task_sim_s": null
  },
  "logging": {
    "state_period_s": 0.2
  }
}
