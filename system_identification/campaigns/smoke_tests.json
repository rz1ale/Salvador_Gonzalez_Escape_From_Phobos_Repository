{
  "schema_version": 1,
  "mode": "automatic",
  "manual_session": "continue",
  "entry": "system_identification/campaigns/identification.py",
  "parameters": {
    "settings_file": "system_identification/campaigns/settings.json"
  },
  "model": null,
  "dependencies": [
    "system_identification/campaigns/settings.json",
    "system_identification/__init__.py",
    "system_identification/campaigns/__init__.py",
    "system_identification/campaigns/flight_math.py"
  ],
  "output_root": "system_identification/data_sets",
  "schedule": {
    "cases": [
      {
        "id": "SMOKE01_LIFT",
        "parameters": {
          "family": "smoke_lift",
          "split": "smoke",
          "smoke_id": "SMOKE01_LIFT"
        }
      },
      {
        "id": "SMOKE02_PULSES",
        "parameters": {
          "family": "smoke_pulses",
          "split": "smoke",
          "smoke_id": "SMOKE02_PULSES"
        }
      },
      {
        "id": "SMOKE03_COAST_MIXED",
        "parameters": {
          "family": "smoke_coast_mixed",
          "split": "smoke",
          "smoke_id": "SMOKE03_COAST_MIXED"
        }
      }
    ],
    "repetitions_per_case": 1,
    "repeat_set": {
      "mode": "fixed",
      "count": 1
    },
    "order": "listed"
  },
  "retry": {
    "max_retries_per_trial": 0,
    "retry_on": [
      "startup_timeout",
      "backend_disconnect",
      "process_exit"
    ],
    "on_exhausted": "pause"
  },
  "on_task_failure": "pause",
  "limits": {
    "startup_wall_s": 150,
    "heartbeat_wall_s": 45,
    "clock_stall_wall_s": 90,
    "attempt_wall_s": 480,
    "shutdown_wall_s": 30,
    "task_sim_s": null
  },
  "logging": {
    "state_period_s": 0.2
  }
}
