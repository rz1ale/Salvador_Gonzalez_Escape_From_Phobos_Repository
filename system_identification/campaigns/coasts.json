{
  "schema_version": 1,
  "mode": "automatic",
  "manual_session": "continue",
  "entry": "system_identification/campaigns/identification.py",
  "parameters": {
    "settings_file": "system_identification/campaigns/settings.json"
  },
  "model": null,
  "dependencies": [
    "system_identification/campaigns/settings.json",
    "system_identification/__init__.py",
    "system_identification/campaigns/__init__.py",
    "system_identification/campaigns/flight_math.py"
  ],
  "output_root": "system_identification/data_sets",
  "schedule": {
    "cases": [
      {
        "id": "COAST_H22",
        "parameters": {
          "family": "coast",
          "split": "training",
          "height_m": 22.0,
          "coast_s": 5.0
        }
      },
      {
        "id": "COAST_H28",
        "parameters": {
          "family": "coast",
          "split": "training",
          "height_m": 28.0,
          "coast_s": 5.0
        }
      },
      {
        "id": "COAST_ROLL_P",
        "parameters": {
          "family": "coast",
          "split": "training",
          "attitude_offset_rad": [
            0.15,
            0,
            0
          ],
          "coast_s": 5.0
        }
      },
      {
        "id": "COAST_PITCH_N",
        "parameters": {
          "family": "coast",
          "split": "training",
          "attitude_offset_rad": [
            0,
            -0.15,
            0
          ],
          "coast_s": 5.0
        }
      }
    ],
    "repetitions_per_case": 1,
    "repeat_set": {
      "mode": "fixed",
      "count": 1
    },
    "order": "listed"
  },
  "retry": {
    "max_retries_per_trial": 0,
    "retry_on": [
      "startup_timeout",
      "backend_disconnect",
      "process_exit"
    ],
    "on_exhausted": "pause"
  },
  "on_task_failure": "pause",
  "limits": {
    "startup_wall_s": 150,
    "heartbeat_wall_s": 45,
    "clock_stall_wall_s": 90,
    "attempt_wall_s": 480,
    "shutdown_wall_s": 30,
    "task_sim_s": null
  },
  "logging": {
    "state_period_s": 0.2
  }
}
