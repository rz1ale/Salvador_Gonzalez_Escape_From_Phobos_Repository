{
  "schema_version": 1,
  "mode": "manual",
  "manual_session": "new_on_open",
  "entry": "policy/naive_handoff/entry.py",
  "parameters": {},
  "model": "nominal_model.json",
  "dependencies": [
    "policy/naive_handoff/__init__.py",
    "policy/naive_handoff/accounting.py",
    "policy/naive_handoff/control.py",
    "policy/naive_handoff/entry.py",
    "policy/naive_handoff/settings.json",
    "policy/naive_handoff/mission.json",
    "policy/naive_handoff/assets/reference.npz",
    "policy/naive_handoff/assets/manifest.json"
  ],
  "output_root": "policy/naive_handoff/run_logs",
  "schedule": {
    "cases": [
      {
        "id": "NAIVE_HANDOFF",
        "parameters": {}
      }
    ],
    "repetitions_per_case": 1,
    "repeat_set": {
      "mode": "fixed",
      "count": 1
    },
    "order": "listed"
  },
  "retry": {
    "max_retries_per_trial": 0,
    "retry_on": [
      "startup_timeout",
      "backend_disconnect",
      "simulation_clock_stall"
    ],
    "on_exhausted": "pause"
  },
  "on_task_failure": "continue",
  "limits": {
    "startup_wall_s": 150,
    "heartbeat_wall_s": 45,
    "clock_stall_wall_s": 90,
    "attempt_wall_s": null,
    "shutdown_wall_s": 30,
    "task_sim_s": null
  },
  "logging": {
    "state_period_s": 0.2
  }
}
